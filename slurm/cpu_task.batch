#!/bin/bash
#SBATCH --job-name=so-task
#SBATCH --partition=gpua100largex4
#SBATCH --gpus=1
#SBATCH --cpus-per-task=6
#SBATCH --mem=100G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x-%j.log
#SBATCH --open-mode=append
# Generic runner: sbatch --job-name=<name> slurm/cpu_task.batch <script.jl> [args...]
source $HOME/southern-ocean/slurm/env.sh
echo "=== [$(date -Is)] $@ on $(hostname) ==="
stdbuf -oL -eL $JULIA --project=. "$@"
status=$?
echo "=== [$(date -Is)] done (exit $status) ==="
exit $status
